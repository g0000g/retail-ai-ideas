<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="V12 Model Gateway">
    <mxGraphModel dx="1700" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="V12 — 3-tier model gateway: local by default, MiniMax on explicit escalation, PII never leaves" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="feat" value="Every AI feature&#xa;V01 … V11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="gw" value="LlmGateway   (ai-service · Spring AI 2.0)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="440" height="640" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="1 · classify the task&#xa;FunctionGemma 270M or heuristic&#xa;this hop must be ~free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gw">
          <mxGeometry x="20" y="50" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="2 · cache lookup&#xa;Redis exact hash · pgvector semantic&#xa;NEVER cache tool results, only completions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="gw">
          <mxGeometry x="20" y="126" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="3 · budget check&#xa;Redis token bucket: tenant / feature / session / day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gw">
          <mxGeometry x="20" y="202" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="4 · escalation decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="gw">
          <mxGeometry x="110" y="270" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="5 · PII scrubber&#xa;+ OPA rule  ai.escalation&#xa;FAIL CLOSED — OPA down means no escalation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="gw">
          <mxGeometry x="20" y="378" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="6 · call the chosen tier&#xa;all three are OpenAI-compatible — one ChatClient per named model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gw">
          <mxGeometry x="20" y="456" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="7 · schema validation + repair&#xa;2 failed repairs on tier 0 → escalate rather than spin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gw">
          <mxGeometry x="20" y="528" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="8 · meter: tokens · cost · latency · tier · route reason&#xa;+ prompt/response log with task_id for later cost analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gw">
          <mxGeometry x="20" y="600" width="400" height="56" as="geometry" />
        </mxCell>

        <mxCell id="rules" value="Escalate to tier 2 when ANY:&#xa;&#xa;• tool-loop depth &amp;gt; 3&#xa;• input &amp;gt; ~6K tokens&#xa;• output needs &amp;gt; ~800 tokens of prose&#xa;• task ∈ {multi-step reasoning, code,&#xa;   complex extraction, negotiation}&#xa;• 2 failed schema validations on tier 0&#xa;• user retried / asked &quot;kỹ hơn&quot;&#xa;&#xa;NEVER escalate when:&#xa;• prompt carries PII → scrub or refuse&#xa;• cache hit&#xa;• budget exhausted → degrade honestly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="220" height="290" as="geometry" />
        </mxCell>

        <mxCell id="t0" value="TIER 0 — LOCAL   (default, ~85%+ of turns)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="t0a" value="Ollama   http://ollama:11434/v1   (CPU)&#xa;qwen3.5:4b-q4_K_M      default chat + tools&#xa;gemma4:e4b             native function calling&#xa;FunctionGemma 270M     router&#xa;bge-m3                 embeddings (dense+sparse)&#xa;bge-reranker-v2-m3     reranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="t0">
          <mxGeometry x="20" y="44" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t0b" value="Model sidecar   (FastAPI, CPU)&#xa;Chronos-2 120M    Apache-2.0   forecasting&#xa;PhoWhisper       844h VN      ASR&#xa;PaddleOCR/VietOCR Apache-2.0   documents&#xa;RT-DETRv2+ByteTrack Apache/MIT vision&#xa;Piper / viXTTS                 Vietnamese TTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="t0">
          <mxGeometry x="20" y="176" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t0c" value="cost 0 VND · no egress · works with the proxy down" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#3d7a2a;" vertex="1" parent="t0">
          <mxGeometry x="20" y="300" width="380" height="20" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="TIER 1 — self-hosted vLLM 14–30B&#xa;documented only · no GPU today · MiniMax-M2/M2.5 weights are MIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="460" width="420" height="70" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="TIER 2 — MiniMax API   (escalation, target &amp;lt; 15%)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#fff8ef;strokeColor=#d79b00;fontStyle=1;fontSize=12;fontColor=#a56a00;" vertex="1" parent="1">
          <mxGeometry x="820" y="560" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="t2a" value="https://api.minimax.io/v1   ·   Authorization: Bearer&#xa;OpenAI-compatible — use the NATIVE endpoint,&#xa;not the /anthropic shim (stringified tool-arg bug)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="t2">
          <mxGeometry x="20" y="44" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="t2b" value="MiniMax-M2.5    $0.15 in / $0.90 out per M tokens&#xa;output bills ~4× input → cap max_tokens hard&#xa;stable prompt prefixes → cache reads are cheap&#xa;temperature 0.2 · top_p 0.95 for analytical work&#xa;reasoning cannot be disabled — budget for it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="t2">
          <mxGeometry x="20" y="122" width="380" height="106" as="geometry" />
        </mxCell>

        <mxCell id="obs" value="OTel GenAI semantic conventions → Tempo · Mimir · Grafana&#xa;gen_ai.request.model · gen_ai.usage.*_tokens · ai.llm.tier · ai.llm.route.reason&#xa;dashboards: tier mix · cost/day per feature · escalation rate · cache hit rate&#xa;⚠ check the semconv version before pinning attribute names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="790" width="950" height="90" as="geometry" />
        </mxCell>

        <mxCell id="deny" value="OPA + PII scrubber deny list&#xa;&#xa;customer name / phone / email / address&#xa;employee names&#xa;supplier terms &amp;amp; cost prices&#xa;row-level query results&#xa;&#xa;→ answered on tier 0 or refused.&#xa;Every strip is logged." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1300" y="560" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="why" value="Why tier 0 first&#xa;&#xa;• 0 VND marginal cost&#xa;• no data egress — answers the&#xa;   Decree 13 / PDPL question&#xa;• survives an MITM-proxy block&#xa;• Vietnamese-first models beat&#xa;   generalist hosted ones&#xa;• swapping tier = base-URL change" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1300" y="100" width="340" height="180" as="geometry" />
        </mxCell>

