<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="V02 Staff Scheduling">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="V02 — AI staff scheduling: forecast the demand, compute the labour, solve the roster, explain it in Vietnamese" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1350" height="30" as="geometry" />
        </mxCell>

        <mxCell id="src" value="Inputs — read via the pgpool STANDBY" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="310" height="450" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="order-service + pos-service&#xa;transactions &amp;amp; items per 30-min slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="44" width="280" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="channel-service&#xa;store format · area · opening hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="98" width="280" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="promotion-service&#xa;promo calendar — a traffic driver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="152" width="280" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="purchase-service&#xa;delivery schedule → back-of-house labour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="206" width="280" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="dim_calendar  ❌ MUST BE CREATED&#xa;Tet · holidays · paydays · school terms&#xa;shared with V03 — build once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="src">
          <mxGeometry x="15" y="260" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="HR tables  ❌ MUST BE CREATED&#xa;employee · skill · availability&#xa;contract_terms · leave_request · shift&#xa;≈1 week of unglamorous CRUD.&#xa;This is the idea&apos;s real cost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="src">
          <mxGeometry x="15" y="330" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="fc" value="1 · Slot demand forecast&#xa;&#xa;Chronos-2  (Apache-2.0, 120M, CPU)&#xa;zero-shot + future-known covariates&#xa;→ transactions &amp;amp; items per 30-min slot&#xa;   with quantile bands&#xa;&#xa;baselines: same-slot-last-week, 4-week MA&#xa;nothing ships unless it beats them&#xa;metric: WAPE per store per daypart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="410" y="130" width="330" height="220" as="geometry" />
        </mxCell>

        <mxCell id="lab" value="2 · Labour model&#xa;&#xa;headcount = f(txn rate, items/txn,&#xa;              service rate, role)&#xa;&#xa;staff to the P70 quantile, not the mean —&#xa;understaffing costs more than overstaffing&#xa;&#xa;service rate is a TUNABLE KNOB per store&#xa;(real stores differ for reasons a model&#xa; cannot see; V10 attendance actuals&#xa; turn the knob into a measurement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="390" width="330" height="230" as="geometry" />
        </mxCell>

        <mxCell id="solve" value="3 · OR-Tools CP-SAT roster solve   (Apache-2.0, deterministic)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="430" height="400" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="HARD constraints&#xa;coverage per slot per role&#xa;contract hours · max consecutive days&#xa;minimum rest between shifts · weekly rest day&#xa;skill coverage (≥1 keyholder per shift)&#xa;approved leave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="solve">
          <mxGeometry x="20" y="44" width="390" height="106" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="SOFT objectives&#xa;fairness (night/weekend equity)&#xa;preference match · week-to-week shift stability&#xa;minimise overtime cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="solve">
          <mxGeometry x="20" y="162" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="labour_rule table — rules as reviewable DATA&#xa;VN Labour Code hours · OT caps · night premium&#xa;OT multipliers (weekday/weekend/holiday differ)&#xa;⚠ HR/legal must confirm the numbers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="solve">
          <mxGeometry x="20" y="254" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="solve per store per week — never globally.&#xa;30s cap · warm-start from last week." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e8;strokeColor=#82b366;fontSize=11;dashed=1;" vertex="1" parent="solve">
          <mxGeometry x="20" y="342" width="390" height="44" as="geometry" />
        </mxCell>

        <mxCell id="infeas" value="INFEASIBLE is a feature&#xa;report which constraints conflict,&#xa;in Vietnamese, and let the manager&#xa;choose what to relax.&#xa;Explained infeasibility beats a&#xa;silently bad roster." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="570" width="430" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ui" value="4 · Store manager UI&#xa;&#xa;roster grid · drag to edit&#xa;coverage-vs-forecast overlay&#xa;weekly labour cost readout&#xa;&#xa;status = PROPOSED&#xa;manager approves — never auto-publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1300" y="130" width="330" height="190" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="ai-service scheduling agent" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="1300" y="360" width="330" height="320" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="TIER 0  qwen3.5:4b&#xa;&quot;Hà xin nghỉ chủ nhật&quot;&#xa;→ {employeeId, date, LEAVE}&#xa;schema-constrained + validator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="agent">
          <mxGeometry x="20" y="44" width="290" height="76" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="TIER 2  MiniMax-M2.5&#xa;multi-clause requests:&#xa;&quot;đổi ca Hà với Nam nhưng đừng&#xa; để Nam làm 6 ngày liền&quot;&#xa;→ names stripped to IDs first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="agent">
          <mxGeometry x="20" y="132" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="explain_shift&#xa;grounded on the BINDING constraints&#xa;+ the forecast slot value.&#xa;Never re-derived from prose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="agent">
          <mxGeometry x="20" y="234" width="290" height="70" as="geometry" />
        </mxCell>

        <mxCell id="never" value="The LLM never decides the roster, never overrides a labour rule, never approves.&#xa;It translates language into constraints and explains the solve. The solver decides.&#xa;Employee PII never reaches tier 2 — IDs only.&#xa;&#xa;Trust KPI: manager override rate falling week over week." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="700" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="why2" value="Why this is the best pick&#xa;&#xa;2 of VTI&apos;s 5 published case studies&#xa;are scheduling (10,000+ employees;&#xa;200+ stores).&#xa;&#xa;Rostering is a solved OR problem —&#xa;the missing input was a slot-level&#xa;demand forecast. V03 supplies it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="310" height="220" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="weekly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="src" target="fc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fc" target="lab">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="required headcount per slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="lab" target="solve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="PROPOSED roster" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="solve" target="ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="solve" target="infeas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="constraint delta → re-solve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="agent" target="solve">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1265" y="520" />
              <mxPoint x="1265" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
