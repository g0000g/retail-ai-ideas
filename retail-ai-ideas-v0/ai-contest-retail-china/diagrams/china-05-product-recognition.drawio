<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="C05 Product Recognition">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="C05 — 商品识别 with PP-ShiTuV2: vector retrieval, so a new SKU needs NO retraining" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Every classification-based product recogniser dies on SKU churn. PaddleClas documents &quot;add and use immediately&quot; as the reason PP-ShiTu is deployable in supermarkets — and that is why most shelf-vision pilots stall and this one would not." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1650" height="24" as="geometry" />
        </mxCell>

        <mxCell id="gal" value="GALLERY BUILD   —   this is the whole trick" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="goods-service SKU images&#xa;(MaterialController → MinIO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="gal">
          <mxGeometry x="20" y="44" width="380" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="PP-ShiTuV2 feature model → embedding per image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gal">
          <mxGeometry x="20" y="102" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="vector index&#xa;Faiss inside PaddleClas, or pgvector to reuse ours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="gal">
          <mxGeometry x="20" y="154" width="380" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="NEW SKU  →  embed  →  insert  →  USABLE IMMEDIATELY&#xa;&#xa;No retraining. No pipeline run. No downtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="gal">
          <mxGeometry x="20" y="212" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="⚠ gallery_version per embedding. Re-index on&#xa;packaging change. Never mix versions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;" vertex="1" parent="gal">
          <mxGeometry x="20" y="282" width="380" height="40" as="geometry" />
        </mxCell>

        <mxCell id="risk" value="THE MOST LIKELY CAUSE OF DISAPPOINTMENT&#xa;&#xa;Catalogue images are studio renders on white.&#xa;Shelf images are not.&#xa;&#xa;Measure gallery quality BEFORE promising accuracy,&#xa;and add in-store gallery images per SKU —&#xa;the gallery can mix sources.&#xa;&#xa;Tutorial advice: ~200 annotated images per class,&#xa;COCO format, and RandomErasing augmentation&#xa;when occlusion is severe (i.e. a real shelf)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="420" height="250" as="geometry" />
        </mxCell>

        <mxCell id="inf" value="INFERENCE   (edge box or store tablet)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="480" height="410" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="1 · mainbody detection&#xa;PicoDet / PP-YOLOE+ (PaddleDetection)&#xa;class-agnostic crops — PicoDet TARGETS CPU/mobile,&#xa;which is why the cheap edge box works" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="inf">
          <mxGeometry x="20" y="44" width="440" height="72" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="2 · feature extraction — PP-ShiTuV2 → embedding per crop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="inf">
          <mxGeometry x="20" y="128" width="440" height="42" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="3 · vector retrieval — top-k from the gallery + threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="inf">
          <mxGeometry x="20" y="182" width="440" height="42" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="4 · THREE-WAY DECISION&#xa;high confidence   → SKU identified&#xa;low / ambiguous   → top-3 + human confirm (staff or shopper tap)&#xa;below floor       → &quot;unknown item&quot;  —  NEVER guess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="inf">
          <mxGeometry x="20" y="236" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Report PRECISION AT THE AUTO-ACCEPT THRESHOLD,&#xa;not top-1 accuracy. The operating point is the deliverable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="inf">
          <mxGeometry x="20" y="328" width="440" height="52" as="geometry" />
        </mxCell>

        <mxCell id="bar" value="Barcode still wins when present.&#xa;A barcode is an exact key; an embedding is a similarity.&#xa;Vision is the FALLBACK and the AUDIT tool, not a&#xa;replacement for barcodes. Design the decision order so." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="550" width="480" height="90" as="geometry" />
        </mxCell>

        <mxCell id="out" value="Consumers" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="1060" y="100" width="380" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="MQTT (Mosquitto) → Kafka&#xa;event schema registered in Apicurio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="out">
          <mxGeometry x="20" y="44" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="stock-service&#xa;shelf count vs system stock → reconciliation task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="out">
          <mxGeometry x="20" y="102" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="I03 planogram&#xa;compliance deviation → task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="out">
          <mxGeometry x="20" y="166" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="V01 Scan &amp;amp; Go&#xa;damaged/missing barcode → top-3 → confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="out">
          <mxGeometry x="20" y="230" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="receiving / inventory count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="out">
          <mxGeometry x="20" y="294" width="340" height="26" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="THE LOOP NOTHING ELSE CLOSES&#xa;&#xa;V04 RT-DETRv2  →  &quot;is there a GAP on this shelf?&quot;&#xa;C05 PP-ShiTuV2 →  &quot;WHICH SKU is this?&quot;&#xa;I03 optimizer  →  &quot;which SKU SHOULD be here?&quot;&#xa;&#xa;optimizer produces a planogram&#xa;   → the camera reports what is actually there&#xa;      → deviations become tasks&#xa;&#xa;Both vision models are Apache-2.0 / MIT.&#xa;They solve different halves and compose." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1060" y="470" width="380" height="250" as="geometry" />
        </mxCell>

        <mxCell id="repos" value="Repos &amp;amp; data&#xa;&#xa;PaddlePaddle/PaddleClas — Apache-2.0&#xa;   PP-ShiTuV2, Recall@1 +~8 pts over V1&#xa;PaddlePaddle/PaddleDetection — Apache-2.0&#xa;   PicoDet, PP-YOLOE+&#xa;ColugoMum/Goods_Recognition&#xa;   full training + deployment walkthrough&#xa;&#xa;Bootstrap datasets:&#xa;   SKU-110K   dense shelf detection&#xa;   RP2K · Products-10K   retrieval gallery&#xa;&#xa;→ prove the pipeline on public data BEFORE&#xa;   collecting a single in-store image." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1490" y="100" width="270" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lic" value="Licence position&#xa;&#xa;PaddleClas      Apache-2.0&#xa;PaddleDetection Apache-2.0&#xa;RT-DETRv2       Apache-2.0&#xa;ByteTrack       MIT&#xa;&#xa;No AGPL. No non-commercial weights.&#xa;Put it on a slide." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1490" y="430" width="270" height="180" as="geometry" />
        </mxCell>

        <mxCell id="demo" value="The demo moment:  create a brand-new SKU on stage, add three photos, index it, photograph it on the shelf — recognised immediately, no training run. Time it.&#xa;Known limit to state honestly: visually near-identical variants (same product, 400g vs 800g) should return the SPU GROUP and let a human pick the variant. SpuController / SkuGroupController already model that." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="1720" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="gal" target="inf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gal" target="risk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="inf" target="out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="out" target="loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
