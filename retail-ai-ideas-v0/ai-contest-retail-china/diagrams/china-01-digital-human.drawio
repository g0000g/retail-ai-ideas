<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="C01 Digital Human Livestream">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="C01 — 数字人直播带货: segment-based 店播, because Duix.Heygem is batch synthesis, not real-time" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Livestream GMV ¥7.2T (2025) → ¥9.08T forecast (2026).  The 2025 shift was 店播 — MERCHANT-run streams, +45% YoY, 80,000+ merchants past ¥1M GMV.  A KOL stream is a talent problem; a 24/7 store stream is a software problem." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="block" value="THE BLOCKER, stated up front&#xa;&#xa;Duix.Heygem does cloning + NON-REAL-TIME batch synthesis.&#xa;Real-time interactive avatars need the paid duix.com platform.&#xa;&#xa;So the architecture is segment-based:&#xa;pre-render a clip library → play it in a scheduled loop →&#xa;splice in fresh clips as products, prices and answers change.&#xa;&#xa;It degrades gracefully: if rendering falls behind, the loop keeps&#xa;playing valid older segments instead of going dead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="400" height="220" as="geometry" />
        </mxCell>

        <mxCell id="one" value="1 · AVATAR + VOICE   (one-off, ~1 day per presenter)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="10-second video sample → Duix.Heygem clone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="one">
          <mxGeometry x="20" y="44" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="voice sample → CosyVoice zero-shot clone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="one">
          <mxGeometry x="20" y="88" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="⚠ WRITTEN CONSENT from the person cloned.&#xa;Scoped and revocable. Never a public figure.&#xa;This is the #1 way the project becomes a lawsuit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="one">
          <mxGeometry x="20" y="132" width="360" height="56" as="geometry" />
        </mxCell>

        <mxCell id="two" value="2 · SCRIPT   (continuous)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="490" y="100" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="goods-service      SKU + selling points&#xa;price-service      live channel price&#xa;promotion-service  the actual live offer&#xa;stock-service      remaining units" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="two">
          <mxGeometry x="20" y="44" width="380" height="72" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Qwen3.6 (Apache-2.0) via Qwen-Agent&#xa;structured output → segment script:&#xa;hook · features · price · offer · CTA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="two">
          <mxGeometry x="20" y="128" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="VALIDATOR&#xa;no invented price · no invented discount&#xa;no invented stock · no 绝对化用语 (最好/第一)&#xa;   — advertising-law risk&#xa;length within bounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="two">
          <mxGeometry x="20" y="202" width="380" height="86" as="geometry" />
        </mxCell>

        <mxCell id="three" value="3 · RENDER   (batch, GPU, offline)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="490" y="470" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="script → CosyVoice TTS → Duix.Heygem lip-sync → clip&#xa;one clip per SKU × offer variant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="three">
          <mxGeometry x="20" y="44" width="380" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="⚠ 标识办法 AT THIS STEP, not at publish:&#xa;隐式 — content ID + provider code INTO file metadata&#xa;显式 — burn the AI badge into the layout&#xa;GB 45438—2025.  Deleting/altering labels is prohibited." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="three">
          <mxGeometry x="20" y="108" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="clip library with validity windows (SKU, offer, price-as-of)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e8;strokeColor=#82b366;fontSize=11;" vertex="1" parent="three">
          <mxGeometry x="20" y="192" width="380" height="28" as="geometry" />
        </mxCell>

        <mxCell id="four" value="4 · STREAM   (continuous)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="scheduler — rotate clips by SKU priority&#xa;stock · margin · promo window · viewer count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="four">
          <mxGeometry x="20" y="44" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="OVERLAY — live price + stock read from the services&#xa;NEVER baked into the video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="four">
          <mxGeometry x="20" y="104" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="price-drift check&#xa;clip price ≠ price-service → PULL THE CLIP, re-render&#xa;A clip hard-coding &quot;只剩 20 件&quot; is a compliance problem&#xa;the moment it stops being true." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="four">
          <mxGeometry x="20" y="164" width="380" height="66" as="geometry" />
        </mxCell>

        <mxCell id="five" value="5 · INTERACTION   (the honest part)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="960" y="380" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="live comments → intent classify (Qwen3.6, local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="five">
          <mxGeometry x="20" y="44" width="380" height="34" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="FAQ           → pre-rendered answer clip from the library&#xa;product query  → MCP tools → text overlay + TTS-only reply&#xa;complex        → escalate to a human operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="five">
          <mxGeometry x="20" y="88" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="Nobody is promised a real-time talking avatar.&#xa;Text overlay + voice covers most of it, and the&#xa;operator console covers the rest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e8;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="five">
          <mxGeometry x="20" y="162" width="380" height="62" as="geometry" />
        </mxCell>

        <mxCell id="six" value="6 · ORDER&#xa;&#xa;on-screen product card → existing storefront checkout&#xa;→ order-service, channel = LIVESTREAM&#xa;&#xa;Register the channel in channel-service so pricing,&#xa;promotions and finance reporting work unchanged —&#xa;the same pattern as the ACP channel in N-03." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1430" y="100" width="350" height="200" as="geometry" />
        </mxCell>
        <mxCell id="repos" value="Repos&#xa;&#xa;duixcom/Duix.Heygem — 10s clone, offline,&#xa;   Docker Win/Ubuntu 22.04, ~100GB disk&#xa;   Lite build: 70GB → 13.5GB, audio-only&#xa;Caladog/HeyGem — one-click Windows, 8GB VRAM&#xa;CosyVoice — zero-shot + cross-lingual clone&#xa;QwenAudio/Fun-ASR — Apache-2.0, vLLM streaming&#xa;QwenLM/Qwen-Agent — Apache-2.0, MCP&#xa;op.jinritemai.com — ⚠ enterprise entity required" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1430" y="330" width="350" height="200" as="geometry" />
        </mxCell>
        <mxCell id="meas" value="Measurement (I06 holdout)&#xa;&#xa;GMV per stream hour · conversion per clip&#xa;watch time per segment · escalation rate&#xa;&#xa;Holdout: human-run hours vs digital-human&#xa;hours on the SAME SKU set.&#xa;&#xa;If digital-human hours underperform badly,&#xa;the honest output is &quot;use it for off-peak&#xa;coverage only&quot; — which is still valuable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1430" y="560" width="350" height="210" as="geometry" />
        </mxCell>

        <mxCell id="rule" value="DESIGN RULE that makes this defensible:  price and stock are NEVER inside the rendered video. They are overlays read live from the services.&#xa;Consent, labelling and the price-drift check are the three things a Chinese platform reviewer would actually test — so they are built in, not bolted on." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="block" target="one">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="cloned presenter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="one" target="three">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="two" target="three">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="clip library" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="three" target="four">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="four" target="five">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="four" target="six">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
