<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="R02 Fleet Orchestration">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="R02 — Cross-brand robot fleet orchestration: we build the layer between business systems and a mixed fleet" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Tier A — zero hardware. Phases 1–2 are entirely simulated and still demo the value.   &quot;Nav2 gets a single robot from A to B while dodging obstacles. But without a central brain, robots become their own biggest obstacles.&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1650" height="24" as="geometry" />
        </mxCell>

        <mxCell id="biz" value="Business systems — the intent" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="I03 planogram published&#xa;→ scan route over changed aisles   ·  overnight, low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="biz">
          <mxGeometry x="15" y="42" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="V04 shelf-gap event&#xa;→ targeted re-scan of that bay   ·  within the hour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="biz">
          <mxGeometry x="15" y="92" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="order picked, ready for the floor&#xa;→ delivery task, stockroom → aisle   ·  trading hours, medium" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="biz">
          <mxGeometry x="15" y="142" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="spill / incident reported&#xa;→ cleaning robot   ·  IMMEDIATE, pre-empts everything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="biz">
          <mxGeometry x="15" y="192" width="390" height="30" as="geometry" />
        </mxCell>

        <mxCell id="policy" value="robot_task_policy — priority as REVIEWABLE DATA&#xa;&#xa;Task priority is a BUSINESS decision, not a robotics one.&#xa;Same pattern as labour_rule (V02) and pricing_rule (I01) —&#xa;third time, which is itself an architectural slide." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="orch" value="robot-orchestration service   (new, Java / Spring — OURS)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="440" height="230" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="task translation:  business event → RMF task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="orch">
          <mxGeometry x="20" y="44" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="priority + SLA policy per task type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="orch">
          <mxGeometry x="20" y="92" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="R10 zone gate — PRE-FLIGHT, fail closed&#xa;task routes through a no_go / off_hours zone → REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="orch">
          <mxGeometry x="20" y="140" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="outcome → ai_decision registry (I06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="orch">
          <mxGeometry x="20" y="194" width="400" height="30" as="geometry" />
        </mxCell>

        <mxCell id="rmf" value="Open-RMF   (Apache-2.0 · Intrinsic + OSRF · OSRA-governed since 2024)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="440" height="290" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="traffic de-confliction · task allocation · lifts · doors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rmf">
          <mxGeometry x="20" y="44" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="MUTEX GROUPS — virtual locks on routes and locations&#xa;that only one robot may occupy,&#xa;&quot;mimicking air traffic control principles&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="rmf">
          <mxGeometry x="20" y="90" width="400" height="62" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="automatic re-localisation after lift transit&#xa;→ &quot;set and forget&quot; multi-floor operation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rmf">
          <mxGeometry x="20" y="160" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="dynamic charger / parking assignment&#xa;by situational need, not fixed allocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rmf">
          <mxGeometry x="20" y="216" width="400" height="48" as="geometry" />
        </mxCell>

        <mxCell id="fleets" value="Fleet adapters — two shapes" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="100" width="440" height="290" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="Nav2-native robots&#xa;→ open-rmf/free_fleet over ZENOH&#xa;&quot;if your robot exposes native ROS navigation&#xa;endpoints, it can be readily integrated&quot;&#xa;⚠ zenoh config can filter and rate-limit by topic —&#xa;   store wifi is not warehouse ethernet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="fleets">
          <mxGeometry x="20" y="44" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Vendor-API robots (Geek+, Pudu, Keenon)&#xa;→ full_control adapter from&#xa;   open-rmf/fleet_adapter_template&#xa;&#xa;COPY THIS REFERENCE:&#xa;Ekumen-OS/andino_rmf — a production Nav2 ↔ RMF bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="fleets">
          <mxGeometry x="20" y="150" width="400" height="106" as="geometry" />
        </mxCell>

        <mxCell id="obl" value="What an adapter MUST implement — plan for all three&#xa;&#xa;1 · KINEMATIC TRANSFORMATION&#xa;   facility map coords → robot local frame&#xa;   scale + rotation + offset&#xa;   reference_coordinates needs two sets of [x,y] for the&#xa;   SAME physical locations in both frames&#xa;   ⚠ minimum 4 matching waypoints recommended&#xa;&#xa;2 · NAVIGATION COMMAND MAPPING&#xa;   high-level PathRequest → the robot&#39;s native actions&#xa;&#xa;3 · STATE SYNCHRONISATION&#xa;   continuously publish FleetState (battery, mode, position)&#xa;   back to RMF with MINIMAL DELAY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="420" width="440" height="250" as="geometry" />
        </mxCell>

        <mxCell id="hw" value="Mixed fleet — the hardware we do NOT build" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1520" y="100" width="270" height="290" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="Geek+ AMR&#xa;~56,000 units, RMS does 5,000 in one warehouse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="hw">
          <mxGeometry x="15" y="44" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="Pudu / Keenon service robot&#xa;#1 and #1 globally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="hw">
          <mxGeometry x="15" y="106" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="shelf scanner (R01)&#xa;Nav2-native" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="hw">
          <mxGeometry x="15" y="168" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="Quicktron / HAI&#xa;1,000 AMRs in one scenario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="hw">
          <mxGeometry x="15" y="230" width="240" height="46" as="geometry" />
        </mxCell>

        <mxCell id="gap" value="THE GAP&#xa;&#xa;The research found NO retail-specific&#xa;Open-RMF integration — only warehouse&#xa;and facility deployments.&#xa;&#xa;Retail sites have mixed fleets from&#xa;different vendors that do not talk&#xa;to each other.&#xa;&#xa;Gartner: by 2026 &amp;gt;40% of enterprises&#xa;will require cross-brand scheduling." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1520" y="420" width="270" height="250" as="geometry" />
        </mxCell>

        <mxCell id="line" value="Line in the sand:  we translate business intent into robot tasks and report outcomes.   NOT warehouse task management, NOT inventory logic, NOT robot control, NOT a WMS.&#xa;Versions: core RMF supports ROS 2 Humble / Iron / Jazzy on distro-specific branches; examples target ros-jazzy-nav2-bringup. Use binaries unless you are patching RMF itself.&#xa;Safety is deliberately NOT here — R10 owns it, and shipping a fleet orchestrator without a safety gate is the wrong order." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1750" height="100" as="geometry" />
        </mxCell>
        <mxCell id="metric" value="The metric that justifies the layer:  CROSS-FLEET CONFLICTS AVOIDED.   Plus tasks completed per robot-hour, deadlock/contention events, task latency by type, robot utilisation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1750" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="business events (Kafka)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="biz" target="orch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="policy" target="orch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="RMF API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="orch" target="rmf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="fleet adapters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="rmf" target="fleets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fleets" target="hw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fleets" target="obl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
