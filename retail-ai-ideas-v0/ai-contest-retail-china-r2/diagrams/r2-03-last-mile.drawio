<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="R03 Last Mile">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="R03 — Last-mile robot &amp;amp; drone dispatch: a fulfilment-method decision plus a handoff protocol" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Tier A — zero hardware. Neolix: 17,000+ vehicles, 160M+ km, RaaS SUBSCRIPTION. Zelos: 15,000 units, 300+ cities. We integrate with a service; we never buy a vehicle." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="insight" value="THE DESIGN INSIGHT EVERYONE GETS WRONG&#xa;&#xa;&quot;Meituan&#39;s Beijing Shunyi model uses unmanned vehicles to move&#xa;parcels to TRANSFER STATIONS, with couriers completing the&#xa;last hundred metres.&quot;&#xa;&#xa;Even the market leader runs a HYBRID.&#xa;A plan that assumes the robot completes the whole journey is&#xa;less credible than one that models the handoff —&#xa;and the handoff is where the software value is." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="440" height="210" as="geometry" />
        </mxCell>

        <mxCell id="reg" value="Regulatory status is real, but PER CITY&#xa;&#xa;2023 guidelines from four ministries incl. MIIT permit&#xa;L3/L4 pilot operation on public roads with&#xa;NATIONAL-LEVEL LEGAL STATUS.&#xa;Shenzhen, Shanghai, Hangzhou passed ordinances.&#xa;Beijing&#39;s pilot zone grew 160 → 600 km².&#xa;&#xa;→ encode route availability as DATA, per city,&#xa;   with an effective date." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="440" height="200" as="geometry" />
        </mxCell>

        <mxCell id="flow" value="order-service   (existing: O2oFulfillmentController, DeliveryLogController)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="560" height="440" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="FULFILMENT-METHOD DECISION  ← the actual product&#xa;&#xa;candidate methods per order:&#xa;  · human courier&#xa;  · autonomous vehicle (Neolix / Zelos, vendor API)&#xa;  · drone (Keeta-class, route-constrained)&#xa;  · robot → transfer station + human last 100m   ← THE HYBRID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="flow">
          <mxGeometry x="20" y="44" width="520" height="106" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="scored on:  distance · weight/volume · time window · weather&#xa;route availability · cost per method · COD?  (robots handle cash poorly)&#xa;recipient constraints (high-rise, gated compound, elderly recipient)&#xa;&#xa;DETERMINISTIC SCORING — no LLM in this path, same rule as C03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="flow">
          <mxGeometry x="20" y="160" width="520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="dispatch adapter per vendor&#xa;— the same shape as an Open-RMF fleet adapter (R02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="flow">
          <mxGeometry x="20" y="258" width="520" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="tracking: vendor telemetry → DeliveryLogController → customer ETA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="flow">
          <mxGeometry x="20" y="320" width="520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="HANDOFF PROTOCOL — the part nobody builds&#xa;arrival notification → pickup code → compartment opens → timeout&#xa;→ failed pickup → return-to-station → re-attempt or human fallback&#xa;Model it as a STATE MACHINE in order-service, not ad-hoc calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="flow">
          <mxGeometry x="20" y="374" width="520" height="52" as="geometry" />
        </mxCell>

        <mxCell id="conn" value="Where it connects" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="1160" y="100" width="580" height="290" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="I08 routing&#xa;robots are a VEHICLE CLASS in the same VRP —&#xa;different capacity, speed and access constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="conn">
          <mxGeometry x="20" y="44" width="540" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="C03 instant retail&#xa;the 30-minute promise is where robot delivery is most&#xa;valuable — and 3km is inside robot range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="conn">
          <mxGeometry x="20" y="104" width="540" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="I07 proactive service&#xa;robot ETA feeds notification, and FAILED PICKUP is a&#xa;new proactive-service trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="conn">
          <mxGeometry x="20" y="164" width="540" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="I04 returns   ·   R02 adapters&#xa;&quot;late → no longer wanted&quot; returns change shape;&#xa;an indoor mall delivery robot IS literally an RMF fleet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="conn">
          <mxGeometry x="20" y="224" width="540" height="52" as="geometry" />
        </mxCell>

        <mxCell id="market" value="Market scale&#xa;&#xa;China unmanned logistics → ¥263.4B by 2030, &amp;gt;40%/yr&#xa;Neolix #1 globally (Road to Autonomy, June 2026, 74.7 pts) — Meituan 6th&#xa;RoboSense took a 300,000-unit LiDAR order from Neolix&#xa;Meituan Keeta Drone: 70+ routes, 6 cities, 880,000+ deliveries by Mar 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="410" width="580" height="130" as="geometry" />
        </mxCell>

        <mxCell id="rules" value="Two rules that save a lot of grief&#xa;&#xa;COD → exclude from robot methods by rule, or require prepayment. Robots handle cash badly. One line, big saving.&#xa;WEATHER → route-availability feed; fall back to human courier automatically. Never let a dispatch decision block on an external API." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="line" value="Line in the sand:  choose the method, dispatch, track, handle the handoff.  We do not own vehicles, routes or maintenance.&#xa;Measurement (I06 holdout by zone):  COST PER DELIVERY by method · on-time rate · failed-pickup rate · method mix over time.&#xa;Steps 1–2 and 4 (9 days) are useful even if no robot vendor is ever signed — a fulfilment-method decision layer and a handoff state machine are worth having regardless." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1700" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="insight" target="flow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg" target="flow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow" target="conn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
