<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="I01 Price and Markdown">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="I01 — Price &amp;amp; markdown optimization: elasticity → optimizer under hard commercial constraints → recommendation, never auto-apply" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="src" value="Inputs — pgpool STANDBY" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="380" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="order-service&#xa;units sold at each price point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="44" width="270" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="price-service&#xa;price by channel · cost · margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="96" width="270" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="promotion-service&#xa;past promo depth + dates&#xa;→ the quasi-experiments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="src">
          <mxGeometry x="15" y="148" width="270" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="stock-service&#xa;stock cover · stockout flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="212" width="270" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="I05 cleaned attributes + I03 store clusters&#xa;elasticity is fitted per category × cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="264" width="270" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="marketplace-visible competitor prices&#xa;(Shopee/Lazada via V06 connector)&#xa;NO website scraping — boundary stated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="324" width="270" height="46" as="geometry" />
        </mxCell>

        <mxCell id="el" value="Elasticity — the hard part, done honestly" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="420" height="380" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Prices are NOT set randomly. They move with promos,&#xa;competitors, seasonality and stock pressure — all of&#xa;which also move demand. Naive regression gives a&#xa;biased, often POSITIVE, slope." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="el">
          <mxGeometry x="20" y="44" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="1 · promotion quasi-experiments&#xa;discrete price changes with start/end dates&#xa;→ before / after / control. Best signal we own." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="el">
          <mxGeometry x="20" y="130" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="2 · log-log demand with controls&#xa;log(units) ~ log(price) + promo + holiday + stock&#xa;             + store &amp;amp; week fixed effects&#xa;fitted per category × cluster, never per SKU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="el">
          <mxGeometry x="20" y="202" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="3 · hierarchical shrinkage toward the category prior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="el">
          <mxGeometry x="20" y="288" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="4 · REJECT implausible signs → fall back to the prior&#xa;a positive elasticity means confounding, not a Giffen good" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="el">
          <mxGeometry x="20" y="336" width="380" height="34" as="geometry" />
        </mxCell>

        <mxCell id="exp" value="Propose a real experiment: 20 SKUs × 4 stores × 4 weeks.&#xa;It is the only way to get a clean elasticity — and proposing it&#xa;signals you know the difference between correlation and causation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="420" height="80" as="geometry" />
        </mxCell>

        <mxCell id="opt" value="Optimizer   (OR-Tools, Apache-2.0, CPU)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="420" height="380" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="maximise expected margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="opt">
          <mxGeometry x="20" y="44" width="380" height="36" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="HARD constraints — reviewable DATA in pricing_rule&#xa;margin floor per SKU / category&#xa;price ladder &amp;amp; psychological endings (…9.000 VND)&#xa;competitor gap band  ·  MAP / agreed pricing&#xa;family and pack-size coherence&#xa;max change frequency  ·  max change magnitude&#xa;never reprice an item already in a customer&#39;s cart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="opt">
          <mxGeometry x="20" y="90" width="380" height="128" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="MARKDOWN CADENCE&#xa;remaining stock × remaining lifecycle × elasticity&#xa;→ schedule the cuts so stock clears by the target date&#xa;→ feeds I02 expiry-driven markdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="opt">
          <mxGeometry x="20" y="228" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="records the BINDING CONSTRAINT with every recommendation&#xa;— that is what makes &quot;why not cheaper?&quot; answerable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e8;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="opt">
          <mxGeometry x="20" y="314" width="380" height="52" as="geometry" />
        </mxCell>

        <mxCell id="rec" value="ai_price_recommendation&#xa;sku · store/channel · current → recommended&#xa;expected Δunits · expected Δmargin&#xa;binding constraint · confidence · model_version" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="520" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ui" value="Pricing manager queue&#xa;&#xa;ranked by projected margin impact&#xa;current vs recommended · projected P&amp;amp;L · why&#xa;approve / reject with reason&#xa;&#xa;RECOMMEND, NEVER AUTO-APPLY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1360" y="100" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="apply" value="approved →&#xa;price-service  (base price)&#xa;promotion-service  (promo / markdown,&#xa;via the existing declarative offer schema&#xa;and its validator choke point)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1360" y="320" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="ai-service pricing agent&#xa;explain_price · simulate_price · list_margin_leaks&#xa;&#xa;TIER 0 narrates from a STRUCTURED input&#xa;TIER 2 only for scenario Q&amp;amp;A — aggregates only.&#xa;Cost prices and margins never leave the rack." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1360" y="490" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="hold" value="I06 HOLDOUT&#xa;a control set of stores × categories stays on manual pricing.&#xa;Without it, &quot;+20% revenue&quot; is Amazon&#39;s number, not ours." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1360" y="670" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="no" value="EXPLICITLY OUT OF SCOPE:  personalised per-customer base prices.&#xa;Personalised OFFERS through promotion-service are fine and already planned in V05.&#xa;Personalised PRICES are a fairness and regulatory problem. Saying so is a maturity signal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="src2" value="Sources demanding this:  Oracle (Lifecycle Pricing Optimization; Promotion, Markdown &amp;amp; Offer Optimization)  ·  InsiderOne #6 (elasticity, competitive intelligence)  ·  EndearHQ #2 (Amazon 2.5M reprices/day; +20% revenue, +22% profit)  ·  Emarsys #9, #10 (price sensitivity).&#xa;4 of 8 sources — and the only major use case neither earlier plan folder touched." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;dashed=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1650" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ed1" value="nightly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="src" target="el">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed2" value="elasticity by category × cluster" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="el" target="opt">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-16" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ed3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="opt" target="rec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="opt" target="ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed5" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="ui" target="apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apply" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="hold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="el" target="exp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
