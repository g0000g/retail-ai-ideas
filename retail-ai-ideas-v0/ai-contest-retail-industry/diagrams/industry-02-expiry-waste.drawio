<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="I02 Expiry Markdown">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="I02 — Expiry-driven markdown: &quot;sustainability&quot; with a number attached — kilograms not thrown away" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>

        <mxCell id="gate" value="WEEK-1 GATE — ask this before anything else&#xa;&#xa;Does stock-service track BATCH / LOT and EXPIRY per store?&#xa;&#xa;yes                  → build the full plan&#xa;expiry on SKU only   → FEFO + goods-receipt date + shelf life&#xa;                        = estimated expiry. Say it is an estimate.&#xa;no expiry data       → NOT VIABLE as specified. Fall back to a&#xa;                        slow-mover / dead-stock markdown driven by&#xa;                        days-of-cover. Still useful. Still honest.&#xa;&#xa;This one question decides whether I02 is a 12-day extension of I01&#xa;or a different plan entirely." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="420" height="250" as="geometry" />
        </mxCell>

        <mxCell id="inp" value="Inputs — all shared with plans that already exist" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="stock-service — batch / lot, expiry, on-hand per store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="inp">
          <mxGeometry x="15" y="44" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="V03 Chronos-2 — baseline demand per SKU × store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="inp">
          <mxGeometry x="15" y="92" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="I01 — near-expiry uplift curve per category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="inp">
          <mxGeometry x="15" y="140" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="price-service / goods-service — price, cost, shelf life, pack size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="inp">
          <mxGeometry x="15" y="188" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="i5" value="dim_calendar — Tet and holiday demand cliffs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="inp">
          <mxGeometry x="15" y="236" width="390" height="26" as="geometry" />
        </mxCell>

        <mxCell id="calc" value="The decision, per (SKU, batch, store)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="470" height="360" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="days_left        = expiry − today&#xa;on_hand          = units of this batch at this store&#xa;baseline_demand  = Chronos-2 over days_left&#xa;uplift(discount)  = I01 elasticity, near-expiry context&#xa;expected_sold    = f(baseline, uplift, shelf position,&#xa;                     competing full-price stock)&#xa;expected_waste   = max(0, on_hand − expected_sold)&#xa;&#xa;recovered_margin(d) =&#xa;     expected_sold × (price×(1−d) − cost)&#xa;   − expected_waste × cost&#xa;&#xa;choose d AND the day to apply it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="calc">
          <mxGeometry x="20" y="44" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Two behaviours fall out of the maths:&#xa;• discount EARLY and SHALLOW beats late and deep&#xa;• sometimes the answer is DO NOT DISCOUNT — a model&#xa;   that recommends no action is doing its job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="calc">
          <mxGeometry x="20" y="274" width="430" height="70" as="geometry" />
        </mxCell>

        <mxCell id="opt" value="Markdown optimizer  (OR-Tools, CPU)&#xa;&#xa;store-level constraints:&#xa;max % of assortment on markdown at once&#xa;category markdown ladders · min margin&#xa;label-printing capacity · items per store per day&#xa;&#xa;CATEGORY BLOCKLIST — never mark down where&#xa;discounting near-expiry is restricted&#xa;(health / pharma / infant formula), reviewed by compliance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="490" width="470" height="190" as="geometry" />
        </mxCell>

        <mxCell id="wl" value="Store worklist  (POS / tablet, early morning)&#xa;&#xa;&quot;mark down 12 items today&quot;&#xa;print labels&#xa;SCAN TO CONFIRM APPLIED&#xa;&#xa;Without the confirm step you cannot measure anything —&#xa;you would not know whether the markdown reached the shelf." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1050" y="90" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="po" value="promotion-service&#xa;batch-scoped offer via the existing&#xa;declarative offer schema + validator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="310" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="feedback loop&#xa;realised sell-through vs predicted, per category&#xa;and per discount depth → re-fit the uplift curve monthly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="430" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="kpi" value="KPIs — this is the pitch" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#fffdf5;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#8a6d1e;" vertex="1" parent="1">
          <mxGeometry x="1050" y="560" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="Write-off value per week — before vs after&#xa;already an accounting line, so it is credible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="kpi">
          <mxGeometry x="15" y="44" width="330" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="Waste avoided — units and VND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="kpi">
          <mxGeometry x="15" y="98" width="330" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="Margin recovered  vs  margin given away&#xa;guards against discounting what would have sold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="kpi">
          <mxGeometry x="15" y="140" width="330" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k4" value="Markdown ROI = recovered margin ÷ discount cost&#xa;the number a CFO asks for" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="kpi">
          <mxGeometry x="15" y="194" width="330" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k5" value="Compliance rate — recommended markdowns&#xa;actually applied in store. Predicts everything else." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="kpi">
          <mxGeometry x="15" y="248" width="330" height="46" as="geometry" />
        </mxCell>

        <mxCell id="why" value="Why this is the strongest &quot;green&quot; idea available:  waste reduction and margin recovery are the SAME action, so nobody is asked to spend money to be virtuous.&#xa;The measurement is unambiguous — write-off value is already an accounting line, and before/after shows up in weeks.&#xa;Only claim what is measured: report VND and units; report CO₂e only with a citable factor.  Sources: InsiderOne #9, #5  ·  NetSuite (perishables)  ·  Innowise (green retailing)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;dashed=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="970" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ea" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="inp" target="calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="calc" target="opt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec" value="daily worklist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="calc" target="wl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed" value="applied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="wl" target="po">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="po" target="fb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fb" target="kpi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="inp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
