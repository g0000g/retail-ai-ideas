<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="I06 Governance">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="I06 — AI governance &amp;amp; impact measurement: one table, one job, one dashboard, one page" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Not one of the eight sources says the blocker is model accuracy. They all say: review AI decisions · measure real business impact · privacy · keep recommendation quality · connect promotions with available inventory." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="feats" value="Every AI feature across all three plan folders" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ff1" value="N-01 copilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="20" y="44" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ff2" value="V02 rostering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="212" y="44" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ff3" value="V03 forecast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="404" y="44" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ff4" value="V05 recommendations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="596" y="44" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ff5" value="V07 document AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="788" y="44" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ff6" value="I01 pricing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="980" y="44" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ff7" value="I02 markdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="1172" y="44" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ff8" value="I04 returns  …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="feats">
          <mxGeometry x="1364" y="44" width="176" height="34" as="geometry" />
        </mxCell>

        <mxCell id="reg" value="1 · DECISION REGISTRY — ai_decision, one row per AI decision" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="rg1" value="feature · subject_type · subject_id&#xa;decision (the structured recommendation)&#xa;inputs_hash · model_name · model_version · prompt_version&#xa;confidence · top_factors  (SHAP, binding constraint, citations)&#xa;tier  (0 local | 2 MiniMax — from V12)&#xa;human_action  APPROVED | REJECTED | EDITED | AUTO&#xa;human_reason · actor · ts&#xa;outcome_measured_at · outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="reg">
          <mxGeometry x="20" y="44" width="580" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rg2" value="Four questions it makes answerable:&#xa;• why did it recommend that?      → top_factors + model_version&#xa;• how often do humans override?   → THE BEST TRUST KPI, free to collect&#xa;• which version decided this?     → reproducible six weeks later&#xa;• did it work?                     → outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;fontStyle=1" vertex="1" parent="reg">
          <mxGeometry x="20" y="196" width="580" height="90" as="geometry" />
        </mxCell>

        <mxCell id="meas" value="2 · IMPACT MEASUREMENT — holdouts, not before/after" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#fffdf5;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#8a6d1e;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ms0" value="Before/after is NOT measurement. Tet moves, a competitor opens,&#xa;the weather changes. Every number in the eight sources is a&#xa;vendor&#39;s before/after." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;fontStyle=1" vertex="1" parent="meas">
          <mxGeometry x="20" y="44" width="580" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ms1" value="I01 pricing        store × category   margin/unit, units&#xa;I02 markdown       store              write-off value, margin recovered&#xa;I03 assortment     cluster subset     CATEGORY contribution&#xa;I04 size guidance  session            return rate, conversion&#xa;V05 recommendations customer          AOV, revenue per visitor&#xa;V03 forecast       SKU × store        WAPE vs baseline, stockout rate&#xa;V02 rostering      store              labour cost %, coverage gap&#xa;V07 document AI    invoice stream     min/invoice, auto-approval rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="meas">
          <mxGeometry x="20" y="110" width="580" height="126" as="geometry" />
        </mxCell>
        <mxCell id="ms2" value="Pre-registered primary metric · minimum detectable effect · stopping rule&#xa;A result reported without a confidence interval is a CLAIM, not a measurement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;fontStyle=1" vertex="1" parent="meas">
          <mxGeometry x="20" y="246" width="580" height="44" as="geometry" />
        </mxCell>

        <mxCell id="modreg" value="3 · MODEL &amp;amp; DATA REGISTER — one page" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="1360" y="250" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="mr1" value="model · version · source URL · licence&#xa;commercial use Y/N · tier it runs on&#xa;data it sees · owner · approved by · date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="modreg">
          <mxGeometry x="20" y="44" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mr2" value="IN:  RT-DETRv2 Apache-2.0 · ByteTrack MIT&#xa;     Chronos-2 Apache-2.0 · bge-m3 MIT&#xa;     PaddleOCR Apache-2.0 · MiniMax-M2.5 (API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="modreg">
          <mxGeometry x="20" y="116" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mr3" value="DELIBERATELY OUT, with the reason:&#xa;  Ultralytics YOLO — AGPL-3.0 network clause&#xa;  InsightFace weights — non-commercial&#xa;  FLUX Kontext Dev — non-commercial&#xa;  MiniMax-M2.7 weights — Modified-MIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="modreg">
          <mxGeometry x="20" y="188" width="380" height="90" as="geometry" />
        </mxCell>

        <mxCell id="guard" value="4 · CONSISTENCY GUARD — &quot;connect promotions with available inventory&quot; (NetSuite&#39;s exact challenge)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#fff8ef;strokeColor=#d79b00;fontStyle=1;fontSize=12;fontColor=#a56a00;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="promotion pushes an out-of-stock SKU&#xa;→ offer activation checks stock-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="guard">
          <mxGeometry x="20" y="44" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="I01 raises a price while I02 marks the batch down&#xa;→ markdown wins for dated stock (precedence rule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="guard">
          <mxGeometry x="440" y="44" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="V05 recommends a SKU that I03 is delisting&#xa;→ recommendation filter reads the assortment plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="guard">
          <mxGeometry x="860" y="44" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="V03 orders stock for a delisted SKU&#xa;→ PO suggestion checks assortment status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="guard">
          <mxGeometry x="20" y="110" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="two offers stack into a negative margin&#xa;→ check the margin floor before activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="guard">
          <mxGeometry x="440" y="110" width="400" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="conflicts are written to the registry as&#xa;REJECTED — conflict with X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="guard">
          <mxGeometry x="860" y="110" width="400" height="52" as="geometry" />
        </mxCell>

        <mxCell id="dash" value="Grafana feature scorecard&#xa;(LGTM already deployed)&#xa;&#xa;one row per AI feature:&#xa;decision volume&#xa;OVERRIDE RATE&#xa;measured impact + CI&#xa;tier mix &amp;amp; cost (from V12)&#xa;calibration drift&#xa;&#xa;This dashboard is the forcing&#xa;function that stops the registry&#xa;becoming write-only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1360" y="600" width="420" height="270" as="geometry" />
        </mxCell>

        <mxCell id="cost" value="Total cost:  one table · one nightly job · one dashboard · one page  ≈ 10 dev-days.&#xa;Cheaper than any feature it governs — and it upgrades every plan in all three folders from a CLAIM to a MEASUREMENT.&#xa;&#xa;The slide that wins:  &quot;personalization — effect not yet distinguishable from zero at this volume; here is the minimum detectable effect and when we will know.&quot;&#xa;Judges trust the deck MORE after that slide, not less." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="one line per feature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="feats" target="reg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="feats" target="meas">
