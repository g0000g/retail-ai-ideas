        <mxCell id="c436" value="Deliberately declined, with a stated reason" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="1148" width="560" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c437" value="26 distinct industry use cases.   21 planned, or deliberately declined with a reason.&#xa;&#xa;All eight sources are vendor or vendor-adjacent marketing — six are product pages.&#xa;Their statistics are evidence of what the market is BUYING, not of what will happen here.&#xa;Quote them with attribution and pair each with our own measured baseline.&#xa;That is exactly what I06 exists to produce." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="1200" width="630" height="130" as="geometry" />
        </mxCell>
      </root>
