<mxfile host="drawio" version="30.3.6">
  <diagram name="West Landscape">
    <mxGraphModel dx="1900" dy="1300" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Western retail AI — organised by the regulatory clock, because that is what binds here" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="In China the binding constraint was WHERE THE DATA LIVES. In the West it is WHAT THE AI SYSTEM IS ALLOWED TO DO — documented, logged and provable, with dates and penalties already attached." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="axis" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="228" width="1780" height="4" as="geometry" />
        </mxCell>
        <mxCell id="axl" value="LIVE NOW  ────────────────────────────────────────────────────────────────────  INSIDE THE CONTEST HORIZON  ──────────────────────────────  LATER" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="248" width="1780" height="20" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="Feb 2025&#xa;EMOTION-RECOGNITION BAN&#xa;+ AI literacy&#xa;absolute prohibition on inferring&#xa;employee / candidate emotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="28 Jun 2025&#xa;EUROPEAN ACCESSIBILITY ACT&#xa;e-commerce in scope&#xa;WCAG 2.1 AA / EN 301 549&#xa;≥10 staff &amp;amp; ≥€2M · to €500k + daily" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Jul → Nov 2025&#xa;ENFORCEMENT STARTS&#xa;France: formal legal notices&#xa;Sweden: market surveillance&#xa;FIRST EAA LAWSUITS FILED (FR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="1 Jun 2026&#xa;COLORADO AI ACT&#xa;first US state with affirmative&#xa;DEPLOYER obligations for high-risk&#xa;+ California CCPA ADMT rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="90" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="2 Aug 2026&#xa;ART. 50 TRANSPARENCY&#xa;+ GPAI ENFORCEMENT &amp;amp; PENALTIES&#xa;the paper-compliance year ends&#xa;up to €35M or 7% of global revenue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="90" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="2 Dec 2026&#xa;CONTENT MARKING&#xa;AI-generated copy, images, avatars&#xa;→ SAME mechanism as China&#39;s 标识办法&#xa;   mint at generation, one build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1410" y="90" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="2027 →&#xa;DPP batteries mandatory (2027)&#xa;EAA legacy contracts (28 Jun 2027)&#xa;HIGH-RISK EMPLOYMENT&#xa;2 Dec 2027 — IF the Omnibus was&#xa;adopted before 2 Aug 2026 ⚠" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1680" y="86" width="200" height="134" as="geometry" />
        </mxCell>

        <mxCell id="rowh" value="The 10 ideas, each under the clock that drives it" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="w02" value="[W02] Accessibility remediation copilot&#xa;⭐ MOST URGENT + CHEAPEST&#xa;&#xa;The only item here with LAWSUITS ALREADY FILED.&#xa;axe-core + Pa11y + Lighthouse → component attribution&#xa;→ drafted Angular patch → draft PR, never auto-merge.&#xa;⚠ automation catches ~1/3 of WCAG issues — say so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="w01" value="[W01] EU AI Act compliance layer&#xa;⭐ THE DIFFERENTIATOR&#xa;&#xa;Inventory · risk classification · provider-status guard&#xa;· FRIA · ONE INCIDENT, THREE CLOCKS (24h NIS2 /&#xa;72h GDPR / 15d AI Act).&#xa;Over half of organisations have no AI inventory." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="w07" value="[W07] Compliant workforce AI&#xa;⭐ NOBODY ELSE WILL DO THIS&#xa;&#xa;V02 staff scheduling — &quot;best pick&quot; in the VTI set —&#xa;IS A HIGH-RISK AI SYSTEM IN THE EU (Annex III).&#xa;Still buildable: 7 obligations, 6 already built by I06.&#xa;The roster is decided by a SOLVER, not a model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="320" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="w03" value="[W03] Multi-protocol agentic merchant&#xa;⭐ supersedes set-1 idea 03&#xa;&#xa;ACP = checkout · AP2 = payment CONSENT · UCP = merchant&#xa;AP2 donated to the FIDO Alliance 28 Apr 2026.&#xa;ChatGPT Instant Checkout shut down Mar 2026 —&#xa;the 4% fee is of UNCONFIRMED applicability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1180" y="320" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="w09" value="[W09] Agent discovery optimisation&#xa;⭐ cheap, no owner anywhere&#xa;&#xa;&quot;optimise product data for AI agent discovery&quot;.&#xa;genAI traffic to US retail +4,700% YoY.&#xa;The failure is SILENT: an agent that cannot tell if a&#xa;shirt is cotton simply does not return it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1560" y="320" width="340" height="150" as="geometry" />
        </mxCell>

        <mxCell id="w06" value="[W06] Fixed-camera shelf intelligence&#xa;⭐ better than a robot, in the West&#xa;&#xa;Bossa Nova: 500+ Walmart stores, CANCELLED Nov 2020,&#xa;vendor laid off 50%. All three reasons non-technical:&#xa;labour re-deployment flipped the ROI · CUSTOMER&#xa;DISCOMFORT with six-foot machines · simpler methods won.&#xa;&quot;Fixed cameras imperil the value of robotic scanning.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="w05" value="[W05] Warehouse fleet orchestration&#xa;&#xa;Back-of-house automates before front-of-house —&#xa;the 2026 capital flows confirm it.&#xa;Amazon ≥€10B in EUROPE · Symbotic↔Walmart fused&#xa;· 85,000+ units deployed. Amazon&#39;s stack is CLOSED;&#xa;what you can buy is Locus / Geek+ / AutoStore.&#xa;R02&#39;s layer, DC scope, carrier cut-off as the clock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="490" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="w04" value="[W04] Digital Product Passport readiness&#xa;&#xa;ESPR in force; delegated acts 2026–2030;&#xa;batteries mandatory 2027; textiles/electronics priority.&#xa;NOT an AI project — a product-data project with a&#xa;legal deadline. AI does exactly two jobs:&#xa;supplier-document extraction, and gap detection.&#xa;Double duty: DPP + CSRD + W10 + W09 from one build." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="490" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="w10" value="[W10] Circularity: returns → resale → reporting&#xa;&#xa;I04 stops returns; W10 recovers value from the rest.&#xa;The leak is the INSPECTION DECISION — made in&#xa;seconds without knowing resale value or stock position.&#xa;Counter-metric that keeps it honest:&#xa;restock-to-second-return rate.&#xa;CSRD export from the same records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="490" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="w08" value="[W08] Sidewalk / road robots&#xa;+ micro-fulfilment&#xa;&#xa;⚠ Western robot-vendor SCALE NOT VERIFIED&#xa;in this research round — stated openly.&#xa;What survives: the ORIGIN decision, which&#xa;micro-fulfilment makes a real choice.&#xa;Regulation is city-level → route availability as DATA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1560" y="490" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="diff" value="Four ways the West differs from China — and each one changes a design" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1160" height="240" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="BINDING CONSTRAINT&#xa;China: data residency (PIPL) → domestic inference&#xa;West: regulation of the AI SYSTEM → documented&#xa;         oversight, ≥6-month logs, FRIA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="diff">
          <mxGeometry x="20" y="44" width="550" height="88" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="LABOUR&#xa;China: 4.5M worker shortfall → robots substitute&#xa;West: high cost, BUT Bossa Nova shows ROI flips&#xa;         when labour is re-deployed. Back-of-house first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="diff">
          <mxGeometry x="590" y="44" width="550" height="88" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="COMMERCE CHANNEL&#xa;China: livestream ¥7.2T · 私域 · 社区团购&#xa;West: agentic commerce — 75% of NRF retailers&#xa;         building it, ~1% of shoppers using it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="diff">
          <mxGeometry x="20" y="140" width="550" height="88" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="STORE ROBOTICS&#xa;China: scaling — Pudu and Keenon #1 and #1 globally&#xa;West: customer-facing store robotics are FRAGILE.&#xa;         Fixed cameras often win.  → W06" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="diff">
          <mxGeometry x="590" y="140" width="550" height="88" as="geometry" />
        </mxCell>

        <mxCell id="reuse" value="What we already built that satisfies this" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=13;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="1240" y="680" width="660" height="240" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="EU AI Act Article 26 obligation      →   what we already run&#xa;──────────────────────────────────────────────────────────&#xa;automatic event logging, ≥6 months    →   ai_decision (I06) + OTel&#xa;operational human-oversight controls  →   I06 human_action + OPA gate (N-12)&#xa;technical documentation               →   model &amp;amp; data register + MLflow&#xa;discriminatory-impact monitoring      →   Evidently slice metrics&#xa;content marking (2 Dec 2026)          →   the SAME mechanism as 标识办法&#xa;incident 24h / 72h / 15d              →   NEW — one record, three routes (W01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="reuse">
          <mxGeometry x="20" y="44" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Six of the eight Western compliance items are already built by I06 and I05." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#3d7a2a;" vertex="1" parent="reuse">
          <mxGeometry x="20" y="192" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="rec" value="Recommended:  W02 → W01 → W09, with W07 as the compliance showpiece.   Add W06 if a store demo is wanted — explaining WHY WE DID NOT USE A ROBOT is a stronger segment than a robot driving down an aisle.&#xa;Check first, it is a yes/no lookup that moves a deadline by 16 months:  was the AI Act Digital Omnibus formally adopted before 2 August 2026?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1860" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lic" value="Western licence pattern — different trap from China.   Not non-commercial weights, but INFRASTRUCTURE PROJECTS RELICENSING AFTER YOU DEPEND ON THEM:  Terraform (BSL 2023 → OpenTofu) · Redis (RSAL/SSPL 2024 → AGPL 2025 → Valkey) ·&#xa;Elasticsearch (SSPL 2021 → AGPL 2024 → OpenSearch) · MongoDB (SSPL) · Grafana (AGPL).  We already run Redis, Elasticsearch and Grafana.   Conditional model licences: Llama (MAU threshold) · Gemma (not OSI) · Mistral (mixed per model).&#xa;Design rule: prefer Apache-2.0 / MIT / BSD under a FOUNDATION (CNCF, LF AI &amp;amp; Data, Apache) over single-vendor open core — which is why OPA, OpenTelemetry, Milvus, Open-RMF and OpenTofu recur across all six folders." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="1860" height="110" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Every claim is sourced in 00-west-regulation.md and 00-west-market-research.md.  The Bossa Nova reporting is contemporaneous 2020 news and is the most solid evidence in this folder; agentic-commerce and robotics market figures include vendor and consultancy material." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="1860" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t3" target="w02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t5" target="w03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t7" target="w09">
