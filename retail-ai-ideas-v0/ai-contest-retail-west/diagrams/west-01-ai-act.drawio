<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="W01 AI Act Layer">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="W01 — EU AI Act compliance layer: four new things, four existing things extended" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Article 26 requires operational controls and automatic event logging — &quot;policy statements and documented intent do not satisfy these requirements.&quot;  Penalties up to €35M or 7% of global revenue. GPAI enforcement powers switch on 2 August 2026." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="gate" value="STEP 1 — ONE LOOKUP, 16 MONTHS&#xa;&#xa;Was the AI Act Digital Omnibus formally&#xa;adopted before 2 August 2026?&#xa;&#xa;YES → high-risk employment obligations&#xa;      run to 2 Dec 2027&#xa;NO  → the ORIGINAL August 2026 timeline&#xa;      applies, and W07 becomes urgent&#xa;&#xa;&quot;Should the Omnibus not be formally adopted&#xa;prior to 2 August 2026, the provisions of the&#xa;original Act … will take effect.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="240" as="geometry" />
        </mxCell>

        <mxCell id="live" value="NOT delayed — live regardless of the Omnibus&#xa;&#xa;EMOTION-RECOGNITION BAN   Feb 2025, absolute&#xa;   an employer may not infer employee/candidate&#xa;   emotion from facial expression or tone of voice&#xa;   → kills a whole class of ideas&#xa;AI LITERACY               Feb 2025, deployers too&#xa;ART. 50 TRANSPARENCY      2 Aug 2026&#xa;CONTENT MARKING           2 Dec 2026&#xa;GPAI ENFORCEMENT          2 Aug 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="380" height="210" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="1 · AI SYSTEM INVENTORY + RISK CLASSIFICATION      NEW" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="470" y="100" width="620" height="290" as="geometry" />
        </mxCell>
        <mxCell id="c1a" value="ai_system(id, name, owner, jurisdiction[],   -- EU · CO · CA · VN · CN&#xa;  purpose, role ENUM(&#39;deployer&#39;,&#39;provider&#39;),&#xa;  risk_class ENUM(&#39;prohibited&#39;,&#39;high&#39;,&#39;limited&#39;,&#39;minimal&#39;),&#xa;  classification_rationale, classified_by, classified_at,&#xa;  annex_iii_category, human_oversight_mechanism,&#xa;  log_retention_days, fria_ref, last_reviewed_at)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="c1">
          <mxGeometry x="20" y="44" width="580" height="108" as="geometry" />
        </mxCell>
        <mxCell id="c1b" value="First pass across six folders — engineering drafts it, COUNSEL corrects it:&#xa;&#xa;V02 scheduling · pick-rate monitoring · CV screening   → HIGH (Annex III employment)&#xa;any staff emotion / sentiment inference               → PROHIBITED&#xa;N-01 / C07 customer chat                              → LIMITED (Art. 50)&#xa;N-02 / C04 generated content                          → LIMITED (content marking)&#xa;I01 pricing · V03 forecast · I05 data quality         → minimal&#xa;I04 returns risk · N-10 abuse scoring                 → ⚠ REVIEW, do not assume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="c1">
          <mxGeometry x="20" y="164" width="580" height="112" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="2 · THE PROVIDER TRAP      NEW" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#fdf3f3;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#8a3a36;" vertex="1" parent="1">
          <mxGeometry x="470" y="420" width="620" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c2a" value="&quot;An organisation that SUBSTANTIALLY MODIFIES an existing AI system&#xa;or adapts it for a specific high-risk purpose BECOMES THE PROVIDER&#xa;in legal terms, and full responsibility for technical documentation&#xa;and conformity assessment shifts to that organisation.&quot;&#xa;&#xa;Fine-tuning an open model for scheduling could do this." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="c2">
          <mxGeometry x="20" y="44" width="580" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c2b" value="ai_system_modification(system_id, ts, actor, kind, description,&#xa;   base_model_ref, provider_status_reviewed, reviewed_by)&#xa;kind ∈ fine_tune · prompt_change · tool_added · purpose_change · threshold_change&#xa;→ purpose_change or fine_tune RAISES A REVIEW FLAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="c2">
          <mxGeometry x="20" y="146" width="580" height="44" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="3 · ONE INCIDENT, THREE CLOCKS      NEW" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#fff8ef;strokeColor=#d79b00;fontStyle=1;fontSize=12;fontColor=#a56a00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="100" width="640" height="290" as="geometry" />
        </mxCell>
        <mxCell id="c3a" value="&quot;Following an AI-related incident, an organisation often has to&#xa;report within three different timeframes: 24 HOURS FOR NIS2,&#xa;72 HOURS FOR GDPR and FIFTEEN DAYS FOR THE AI ACT.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="c3">
          <mxGeometry x="20" y="44" width="600" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c3b" value="detected — from ai_decision · robot_incident (R10) · guardrail block · human report&#xa;        ▼&#xa;  ai_incident — ONE source of truth&#xa;  what · when · systems · data categories · affected parties · severity&#xa;        ▼&#xa;  ┌────────────┬────────────┬────────────┐&#xa;  NIS2 24h     GDPR 72h     AI Act 15d     internal review&#xa;  each with its own template, recipient, owner — AND A COUNTDOWN TIMER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="c3">
          <mxGeometry x="20" y="110" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c3c" value="The countdown timers ARE the feature — they stop a 24-hour deadline&#xa;being missed while someone drafts the 15-day one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="c3">
          <mxGeometry x="20" y="238" width="600" height="42" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="4 · TRANSPARENCY + CONTENT MARKING      NEW mechanism, TWO regimes" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="1140" y="420" width="640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c4a" value="Art. 50 transparency   2 Aug 2026   persistent &quot;AI assistant&quot; disclosure&#xa;                                     IN the interaction, not in a policy&#xa;Content marking        2 Dec 2026   provider identifier + content ID,&#xa;                                     MINTED AT GENERATION, in ai_decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="c4">
          <mxGeometry x="20" y="44" width="600" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c4b" value="IDENTICAL pattern to China&#39;s 标识办法 (显式 + 隐式, GB 45438—2025).&#xa;Build one content-marking mechanism, satisfy BOTH regimes.&#xa;That is a genuinely strong slide." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="c4">
          <mxGeometry x="20" y="130" width="600" height="56" as="geometry" />
        </mxCell>

        <mxCell id="reuse" value="EXTEND, don&#39;t rebuild — what I06 already gives us" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=13;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ru" value="EU AI Act Article 26 obligation              →   what we already run                              status&#xa;──────────────────────────────────────────────────────────────────────────────────────────────────────────&#xa;automatic event logging, retain ≥6 months     →   ai_decision (I06) + OpenTelemetry               extend retention&#xa;operational human-oversight controls          →   I06 human_action + OPA action gate (N-12)       done, fail closed&#xa;technical documentation                       →   model &amp;amp; data register (I06 §3) + MLflow          done&#xa;discriminatory-impact monitoring              →   Evidently slice metrics on the I06 scorecard    wire up&#xa;worker notification                           →   NEW — a UI surface + a per-worker record        W07&#xa;FRIA where required                           →   NEW — versioned document, named owner           W07&#xa;incident reporting 24h / 72h / 15d            →   NEW — one record, three routes, three clocks    W01&#xa;AI system inventory + risk classification     →   NEW — the first deliverable                     W01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="reuse">
          <mxGeometry x="20" y="44" width="1700" height="122" as="geometry" />
        </mxCell>

        <mxCell id="multi" value="ONE control layer, SEVERAL regimes.   jurisdiction[] is an array from day one:  EU AI Act (strictest) · Colorado AI Act (deployer obligations, 1 Jun 2026) · California CCPA ADMT · and the China set&#39;s 标识办法 and PIPL.&#xa;Satisfying the EU deployer obligations largely satisfies Colorado and CCPA-ADMT — the sources say so explicitly: it &quot;allows employers to leverage compliance efforts across frameworks.&quot;&#xa;Step 8 is not optional:  AUDIT FOR EMOTION RECOGNITION.  Customer-facing sentiment analytics repurposed onto staff — checkout camera analytics, call-centre tone scoring — is ALREADY PROHIBITED." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1740" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="live">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="reuse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
