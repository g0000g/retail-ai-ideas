        <mxCell id="t912" value="aisle clearance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="20" y="180" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t913" value="needs ~36 inches" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="170" y="180" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t914" value="irrelevant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="390" y="180" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t915" value="cost shape" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="20" y="210" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t916" value="$30–50k/store/year (Simbe economics)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="170" y="210" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t917" value="capex PER BAY, no subscription" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="390" y="210" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t918" value="failure mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="20" y="240" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t919" value="robot down → NO data at all" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="170" y="240" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t920" value="one camera down → one bay blind" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="390" y="240" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t921" value="blocked by shoppers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="20" y="270" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t922" value="must wait or re-plan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="170" y="270" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t923" value="occlusion suppression" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="390" y="270" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t924" value="low-value aisles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="20" y="300" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t925" value="free — it drives past" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="170" y="300" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t926" value="COSTS A CAMERA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="390" y="300" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cm2" value="THE HONEST TRADE-OFF&#xa;Fixed cameras cost PER BAY. Robots cost PER STORE.&#xa;&#xa;→ so the correct design is SELECTIVE: cameras on the bays where&#xa;   out-of-stock costs the most, and NOTHING on the long tail.&#xa;   That is a merchandising decision driven by I03 contribution&#xa;   data — not a technology decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="cmp">
          <mxGeometry x="20" y="344" width="600" height="98" as="geometry" />
        </mxCell>

        <mxCell id="arch" value="Everything below the camera is ALREADY PLANNED" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="1290" y="90" width="470" height="470" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="shelf-edge + ceiling cameras on SELECTED bays&#xa;chosen by lost-sales-per-out-of-stock-hour&#xa;(I03 contribution × V03 forecast)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="arch">
          <mxGeometry x="20" y="44" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="edge box — the SAME ~$150–300 N100 + OpenVINO from V04&#xa;RT-DETRv2   gaps                       V04&#xa;PP-ShiTuV2  which SKU                   C05&#xa;MiniCPM-V   on-box verification pass    round 2&#xa;label read  → PROMOTION-ERROR check     R01&#39;s sleeper feature&#xa;occlusion suppression while a person overlaps a bay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="arch">
          <mxGeometry x="20" y="114" width="430" height="106" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="↓ JSON metadata only.  No video leaves the store.&#xa;MQTT (Mosquitto) → Kafka (Apicurio schema)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="arch">
          <mxGeometry x="20" y="230" width="430" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="stock-service   gap → replenishment task, count → reconciliation&#xa;I03 planogram   compliance deviation → merchandising task&#xa;price-service   label vs system price → promotion-error task&#xa;Grafana         on-shelf availability, gap-hours, promo errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="arch">
          <mxGeometry x="20" y="288" width="430" height="86" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="W06 changes ONLY the sensor placement —&#xa;and that single change removes the three reasons&#xa;Bossa Nova failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="arch">
          <mxGeometry x="20" y="384" width="430" height="66" as="geometry" />
        </mxCell>

        <mxCell id="trust" value="THE LESSON THAT MATTERS MOST, ENCODED&#xa;&#xa;&quot;Trust is the binding constraint. Solutions must be accurate, actionable and frequent, or vendors lose retailers&#39; and associates&#39; trust — INACCURATE DATA CREATES ADDITIONAL WORK INSTEAD OF FREEING ASSOCIATES UP.&quot;&#xa;&#xa;1 · ACTIONABLE, NOT INFORMATIONAL.  Never emit &quot;bay 3 looks empty&quot;. Emit &quot;replenish SKU-1234 in bay 3, 12 units in the back room, estimated lost sales €48/hour&quot;. A task with a quantity and a value, or nothing.&#xa;2 · A FALSE POSITIVE COSTS MORE THAN A MISS.  An associate walking to a full shelf loses trust permanently. Tune the threshold for PRECISION, not recall, and report precision at the operating point.&#xa;3 · MEASURE THE RESPONSE, NOT THE DETECTION.  The KPI is GAP-HOURS CLOSED, not gaps found. A detection nobody acts on is worse than no detection, because it cost someone a walk." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1720" height="180" as="geometry" />
        </mxCell>

        <mxCell id="priv" value="PRIVACY — stricter in the EU than the China plan assumed, and CAMERA PLACEMENT IS THE ARGUMENT&#xa;No face recognition, no biometric identification (GDPR Art. 9; and biometric categorisation is prohibited-practice territory under the AI Act).  No emotion or sentiment inference on customers OR staff — absolute prohibition since Feb 2025.  No staff monitoring: declining to build it is the answer.&#xa;Cameras point at SHELVES, not aisles. A shelf-edge camera 40cm from a bay, framing the bay, is a fundamentally different privacy proposition from a ceiling camera surveying an aisle — AND IT IS BETTER FOR THE DETECTION TASK. Design and compliance agree here, which is rare and worth saying.&#xa;Person detection only for occlusion suppression: box-level, no cross-frame tracking, no identity, discarded immediately.  Metadata only leaves the store; SHELF thumbnails retained days not months.  DPIA before deployment, signage, lawful basis documented." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1720" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=3;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="story" target="cmp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmp" target="arch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
