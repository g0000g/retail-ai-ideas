        <mxCell id="t909" value="customer presence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;fontStyle=1;" vertex="1" parent="cmp">
