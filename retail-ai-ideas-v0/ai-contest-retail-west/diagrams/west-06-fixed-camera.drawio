        <mxCell id="t908" value="CONTINUOUS — a gap in minutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="cmp">
          <mxGeometry x="390" y="104" width="220" height="30" as="geometry" />
