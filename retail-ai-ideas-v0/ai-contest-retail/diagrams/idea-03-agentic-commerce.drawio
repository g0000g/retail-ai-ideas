<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="Idea 03 Agentic Commerce">
    <mxGraphModel dx="1800" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Idea 03 — Agentic Commerce: the storefront becomes an ACP / UCP merchant that AI agents can buy from" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ag" value="External AI Agent&#xa;ChatGPT · Claude · procurement bot&#xa;discovers us, no human browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="110" y="200" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="disc" value="Discovery&#xa;/.well-known/agent-card.json&#xa;/.well-known/ucp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="360" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="idp" value="Keycloak&#xa;agent identity (client credentials)&#xa;per-agent scopes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="510" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="opa" value="OPA policy&#xa;spend cap · category cap&#xa;per session / day&#xa;DENY is the default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="110" y="660" width="230" height="95" as="geometry" />
        </mxCell>

        <mxCell id="prot" value="3 · Protocol surface — new endpoints in ecommerce-bff" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="330" height="330" as="geometry" />
        </mxCell>
        <mxCell id="pa" value="ACP  (REST)&#xa;POST /checkout_sessions&#xa;GET/POST /checkout_sessions/{id}&#xa;.../complete   .../cancel&#xa;post-purchase webhooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="prot">
          <mxGeometry x="20" y="46" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pb" value="UCP  (A2A JSON-RPC)&#xa;POST /a2a&#xa;capability advertisement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="prot">
          <mxGeometry x="20" y="152" width="290" height="66" as="geometry" />
        </mxCell>
        <mxCell id="pc" value="MCP  (browse before buy)&#xa;ai-service tools, already built" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e8;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="prot">
          <mxGeometry x="20" y="234" width="290" height="66" as="geometry" />
        </mxCell>

        <mxCell id="ad" value="One adapter class holds ALL protocol mapping&#xa;— ACP / UCP specs are weeks old and will churn.&#xa;Pin the version, isolate the blast radius." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ch" value="channel-service&#xa;register AGENT as a real sales channel&#xa;→ pricing, promotions, stock pool and&#xa;finance reporting all work unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="740" y="770" width="430" height="100" as="geometry" />
        </mxCell>

