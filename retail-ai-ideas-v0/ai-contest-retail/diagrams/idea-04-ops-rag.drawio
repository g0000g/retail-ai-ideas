          <mxGeometry x="20" y="46" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="Apache Tika extract&#xa;(tables in PDFs are the known weak spot —&#xa;flag low-confidence extractions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="ing">
          <mxGeometry x="300" y="46" width="270" height="76" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="chunk with overlap&#xa;store model_version per chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="ing">
          <mxGeometry x="610" y="46" width="250" height="76" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="embed → pgvector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="ing">
          <mxGeometry x="900" y="46" width="250" height="76" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Why pgvector and not the blueprint&apos;s Elasticsearch backend: our ES is 7.17 and has no native kNN — upgrading ES touches es-mappings, es-client-starter and 11 index definitions.&#xa;Why not Milvus: a new container plus etcd for a corpus of a few thousand chunks. pgvector = one image swap and one Flyway migration (needs spring-boot-flyway on the classpath under SB4).&#xa;Corpus is 10³–10⁴ chunks; pgvector HNSW is comfortable to ~10⁶." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1260" y="720" width="380" height="140" as="geometry" />
        </mxCell>

