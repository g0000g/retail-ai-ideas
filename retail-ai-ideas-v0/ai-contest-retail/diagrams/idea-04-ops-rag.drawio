        <mxCell id="ing" value="Ingestion  (one-off per document, job in workflow-service)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=12;" vertex="1" parent="1">
