          <mxGeometry x="20" y="110" width="360" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="answer with mandatory [doc, page] citations&#xa;below similarity threshold → refuse, do not guess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="docl">
          <mxGeometry x="20" y="166" width="360" height="52" as="geometry" />
        </mxCell>

        <mxCell id="sqll" value="Structured retriever — live business data" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#fffdf5;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#8a6d1e;" vertex="1" parent="1">
          <mxGeometry x="830" y="390" width="400" height="270" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="schema card&#xa;curated reporting VIEWS only (not raw entities)&#xa;+ 3 example question → SQL pairs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="sqll">
          <mxGeometry x="20" y="46" width="360" height="58" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="LLM → SQL&#xa;EXPLAIN before execute · row cap · statement_timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="sqll">
          <mxGeometry x="20" y="116" width="360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="result table + the generated SQL, always shown&#xa;+ one-line NL summary + replica lag footer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="sqll">
          <mxGeometry x="20" y="180" width="360" height="52" as="geometry" />
        </mxCell>

        <mxCell id="pgv" value="Postgres + pgvector&#xa;ai_document_chunk (HNSW)&#xa;tenant_id filtered INSIDE the ANN query" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="120" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stby" value="pgpool → READ STANDBY&#xa;dedicated read-only Postgres role&#xa;writes are impossible by GRANT, not by prompt" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;boundedLbl=1;fontStyle=1" vertex="1" parent="1">
