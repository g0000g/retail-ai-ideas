        </mxCell>

        <mxCell id="nim" value="NVIDIA hosted NIM&#xa;llama-nemotron-embed-1b-v2&#xa;llama-nemotron-rerank-1b-v2&#xa;nemotron-3-nano-30b-a3b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7e0;strokeColor=#76b900;fontSize=11;fontStyle=1" vertex="1" parent="1">
