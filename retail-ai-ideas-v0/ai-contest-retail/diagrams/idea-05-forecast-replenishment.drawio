<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="Idea 05 Forecast and Replenishment">
    <mxGraphModel dx="1700" dy="1000" grid="10" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Idea 05 — Demand forecast &amp;amp; auto-replenishment: nightly CPU ensemble → PO suggestions → buyer approves" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="src" value="Sources (all exist) — read via the pgpool STANDBY, never the primary" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6b4c85;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="450" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="order-service + pos-service&#xa;daily sales qty per SKU × store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="44" width="270" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="after-sales-service&#xa;returns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="98" width="270" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="stock-service&#xa;on-hand / available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="152" width="270" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="purchase-service&#xa;in-transit / open POs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="206" width="270" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="vendor-service&#xa;lead time · MOQ  ⚠ verify populated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="src">
          <mxGeometry x="15" y="260" width="270" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="price-service + promotion-service&#xa;promo intensity — must be a feature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="src">
          <mxGeometry x="15" y="314" width="270" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="dim_calendar  ❌ MUST BE CREATED&#xa;Tet / lunar new year · holidays · paydays&#xa;without this the forecast is worthless in VN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="src">
          <mxGeometry x="15" y="368" width="270" height="64" as="geometry" />
        </mxCell>

        <mxCell id="fb" value="Feature build&#xa;&#xa;reporting SQL views on the standby&#xa;→ daily SKU × location panel&#xa;+ promo / holiday / trend features&#xa;&#xa;⚠ needs ≥ 14 months history&#xa;(one full Tet) — check this FIRST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="180" width="250" height="200" as="geometry" />
        </mxCell>

        <mxCell id="job" value="Forecast job — one CPU container, triggered by workflow-service" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#f3faf1;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#3d7a2a;" vertex="1" parent="1">
          <mxGeometry x="710" y="100" width="380" height="330" as="geometry" />
        </mxCell>
        <mxCell id="j0" value="baselines first: naive seasonal + moving average&#xa;nothing ships unless it beats these" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e8;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="job">
          <mxGeometry x="20" y="44" width="340" height="48" as="geometry" />
        </mxCell>
        <mxCell id="j1" value="ensemble (sklearn / xgboost, CPU)&#xa;Random Forest · XGBoost · Gradient Boosting&#xa;Ridge · SVR  →  weighted blend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="job">
          <mxGeometry x="20" y="102" width="340" height="62" as="geometry" />
        </mxCell>
        <mxCell id="j2" value="walk-forward backtest&#xa;per-series model selection (fast movers vs long tail)&#xa;WMAPE + bias, sliced by ABC class and store format" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="job">
          <mxGeometry x="20" y="174" width="340" height="62" as="geometry" />
        </mxCell>
        <mxCell id="j3" value="cold start: new SKU / new store&#xa;category × store-format average, flagged low-confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e8;strokeColor=#82b366;fontSize=11;dashed=1;" vertex="1" parent="job">
          <mxGeometry x="20" y="246" width="340" height="52" as="geometry" />
        </mxCell>

        <mxCell id="rp" value="Replenishment logic&#xa;&#xa;safety stock from forecast ERROR&#xa;(not a flat %), service level per ABC class&#xa;&#xa;reorder point = lead-time demand + safety stock&#xa;qty respects MOQ · case pack · shelf life" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="710" y="480" width="380" height="170" as="geometry" />
        </mxCell>

        <mxCell id="tbl" value="ai_demand_forecast&#xa;partitioned Postgres table&#xa;(no TimescaleDB, daily granularity)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="po" value="purchase-service&#xa;PO status = SUGGESTED&#xa;&#xa;buyer approves / adjusts / rejects&#xa;— reason captured as feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1160" y="480" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="buyer" value="Buyer dashboard (front-end)&#xa;stockout risks ranked by lost-revenue estimate&#xa;actual vs forecast chart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="700" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="realpo" value="real PO&#xa;→ vendor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1510" y="520" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="ai-service — replenishment agent (MCP tools)&#xa;&#xa;get_forecast · list_stockout_risk&#xa;explain_suggestion · simulate_scenario&#xa;&#xa;explanations grounded on SHAP / feature importances&#xa;— never a re-derivation from the number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="nim" value="NVIDIA hosted NIM&#xa;nemotron-3-nano-30b-a3b&#xa;(explanation + Q&amp;amp;A only —&#xa;the forecast itself is classical ML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7e0;strokeColor=#76b900;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1510" y="140" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Scope discipline: PO suggestions only. Allocation, inter-store transfers and assortment planning are OUT.&#xa;Trust KPI for the pitch: buyer override rate falling over time. Suggest-never-execute is the design, not a limitation.&#xa;Why Python here (unlike ideas 01-04): sklearn / XGBoost have no Java equivalent worth fighting. It is one batch container writing to Postgres — it never joins the Spring service mesh." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1050" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="nightly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="src" target="fb">
